# Primary Groq API key (required)
GROQ_API_KEY=your_groq_api_key_here

# Fallback keys — optional but recommended.
# The agent rotates to the next available key the moment one hits a rate limit,
# so the conversation continues without interruption.
GROQ_API_KEY_2=your_second_groq_key_here
GROQ_API_KEY_3=your_third_groq_key_here
